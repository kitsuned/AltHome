{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext"],
		"module": "ESNext",
		"moduleResolution": "Node",
		"allowSyntheticDefaultImports": true,
		"allowUmdGlobalAccess": true,
		"declaration": false,
		"esModuleInterop": false,
		"isolatedModules": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"useDefineForClassFields": true,
		"experimentalDecorators": true
	}
}
